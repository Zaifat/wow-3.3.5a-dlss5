     Log("[feed32] game device destroyed; shutting down");
+    g_vk_device_dying = g.is_vulkan;
     HostClose();     // drain + end the host while the fences are still alive
     ReleaseShared();
+    g_vk_device_dying = false;
     g.vk = {};
     g.rs_dev = nullptr;
     g.rs_queue = nullptr;
