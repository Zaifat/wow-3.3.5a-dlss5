+// ReShade's vkDestroyDevice deletes every command_queue BEFORE it raises destroy_device
+// (source/vulkan/vulkan_hooks_device.cpp, 6.8.0), so by the time OnDestroyDevice ->
+// HostClose / ReleaseShared call g.rs_queue->wait_idle(), the pointer is dangling and the
+// call faults inside ReShade32.dll (WoW 3.3.5a under DXVK: every resolution change and
+// most exits). Drain while the queue still exists, then forget it: every teardown path
+// below already skips a null rs_queue.
+static void OnDestroyCommandQueue(reshade::api::command_queue *queue)
+{
+    if (queue == nullptr || queue != g.rs_queue) return;
+    Log("[feed32] game command queue destroyed; draining it before the device goes");
+    queue->wait_idle();
+    g.rs_queue = nullptr;
+}
