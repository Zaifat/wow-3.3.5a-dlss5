+            if (g.vk_img[i] != VK_NULL_HANDLE) { if (!g_vk_device_dying) g.vk.DestroyImage(g.vk.dev, g.vk_img[i], nullptr); g.vk_img[i] = VK_NULL_HANDLE; }
